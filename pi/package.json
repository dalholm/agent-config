{
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "@effect/platform-node": "^4.0.0-beta.99",
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "acorn": "^8.17.0",
    "effect": "^4.0.0-beta.99",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0-beta.99",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"*.json\"",
    "test": "npm --prefix extensions/background-terminals test && npm --prefix extensions/git-info test && npm --prefix extensions/subagents test && npm --prefix extensions/summaries test && node --test --experimental-strip-types extensions/shared/*.test.ts extensions/workflows/*.test.ts && npm --prefix extensions/file-search test",
    "test:live": "npm --prefix extensions/subagents run test:live"
  }
}
